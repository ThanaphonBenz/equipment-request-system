# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง

# Connection string จาก MongoDB Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/equipment_request?retryWrites=true&w=majority

# ข้อความสุ่มยาวๆ สำหรับเซ็น cookie session
SESSION_SECRET=change-me-to-a-long-random-string
